<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- numbercall and doall are deliberately absent: Odoo 18 removed both
             from ir.cron, so naming them would make this file fail to load on the
             two newest series while working fine on 16 and 17.

             The record ships active, but _cron_shopify_sync only touches channels
             whose owner switched auto_sync on, and that defaults to off. So
             installing the module still moves no data on its own. -->
        <record id="cron_shopify_sync" model="ir.cron">
            <field name="name">Shopify: scheduled sync</field>
            <field name="model_id" ref="miko_ecommerce_core.model_miko_ecommerce_channel"/>
            <field name="state">code</field>
            <field name="code">model._cron_shopify_sync()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
